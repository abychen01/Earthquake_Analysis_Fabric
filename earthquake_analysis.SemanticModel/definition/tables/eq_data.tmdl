	measure eq_count = COUNTROWS(eq_data)
		formatString: 0
		lineageTag: de6cf259-58cd-4ebe-94c1-7c4e53e8865a

	measure eq_count_last_24h = ```
			
			    CALCULATE(
			        COUNTROWS(eq_data),
			        FILTER(
			            ALL(eq_data),
			           eq_data[event_date] + eq_data[event_time] > NOW() - 1
			        ))
			```
		formatString: 0
		lineageTag: 54c7523f-c89b-401c-a4ad-fdc9ef9f543d

	measure latest_eq_location = ```
			
			    var city = 
			        CALCULATE(
			            MAX(eq_data[City]),
			            FILTER(
			            ALL(eq_data),
			            eq_data[event_date] = [latest_eq_date] && eq_data[event_time] = [latest_eq_time]
			        )
			    )
			    var country = 
			        CALCULATE(
			            MAX(eq_data[Country]),
			            FILTER(
			            ALL(eq_data),
			            eq_data[event_date] = [latest_eq_date] && eq_data[event_time] = [latest_eq_time]
			        )
			    )
			    var state = 
			        CALCULATE(
			            MAX(eq_data[State]),
			            FILTER(
			            ALL(eq_data),
			            eq_data[event_date] = [latest_eq_date] && eq_data[event_time] = [latest_eq_time]
			        )
			    )
			    RETURN
			        city & ", " & state & ", " & country
			
			```
		lineageTag: d177fcb2-740f-4969-bfb6-4e83cb152202

