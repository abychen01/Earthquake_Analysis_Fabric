	measure eq_type =
			
			VAR Magnitude = SELECTEDVALUE(eq_data[magnitude])
			RETURN
			SWITCH(
			    TRUE(),
			    Magnitude < 3.0, "Minor",
			    Magnitude < 5.0, "Light",
			    Magnitude < 7.0, "Moderate",
			    Magnitude < 9.0, "Strong",
			    Magnitude >= 9.0, "Massive",
			    "Unknown"
			)
		lineageTag: 5fa4a3ba-89c0-4960-8ded-ec05621be877

	measure time_from_last_eq = ```
			
			    NOW() - ([latest_eq_date] + [latest_eq_time])
			```
		formatString: hh:nn:ss
		lineageTag: 3ace0c7d-b5f7-47ea-ba45-a71596a5cea7

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure within_last_24_hrs =
			
			IF (
			    (MAX (eq_data[event_date]) + MAX(eq_data[event_time])) >= NOW() - 1,
			    1,
			    0
			)
		formatString: 0
		lineageTag: ce490d5d-967a-4c91-8034-d24fafec81db

	measure max_mag = max(eq_data[magnitude])
		lineageTag: 1dc2a6be-b1bb-40e0-9f02-6bf771594263

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Most Common Severity' = ```
			
			    VAR TopSeverity =
			        TOPN (
			            1,
			            SUMMARIZE (
			                eq_data,
			                eq_data[EarthquakeType],
			                "SeverityCount", COUNTROWS ( eq_data )
			            ),
			            [SeverityCount], DESC
			        )
			    RETURN
			        MAXX ( TopSeverity, eq_data[EarthquakeType] )
			```
		lineageTag: 376263e2-aac4-4e2a-936a-fc5a26feab00

	measure eq_above_5% = ```
			
			    var eq_count_above_5 = 
			        CALCULATE(
			            COUNTROWS(eq_data),
			            FILTER(
			                eq_data,
			                eq_data[magnitude]>=5
			        )
			    )
			    var total_eq_count = COUNTROWS(eq_data)
			
			    RETURN 
			        DIVIDE( eq_count_above_5, total_eq_count) 
			    
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 04dd9358-73ba-4636-8e22-cc576c87a212

