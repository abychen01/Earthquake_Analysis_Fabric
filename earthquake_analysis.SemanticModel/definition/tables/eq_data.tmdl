table eq_data
	lineageTag: e7fce76b-fe4c-4397-97b2-ccda2a66756b

	measure latest_eq_date = ```
			
			    CALCULATE(
			        MAX(eq_data[event_date]),
			        ALL(eq_data)
			    )
			```
		formatString: dd/mm/yy
		lineageTag: 8c2a7a3b-0ce6-4a87-87d3-a2ec4a992414

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure latest_eq_time = ```
			
			    CALCULATE(
			        MAX(eq_data[event_time]),
			        FILTER(
			            ALL(eq_data),
			            eq_data[event_date] = [latest_eq_date]
			        )
			    )
			```
		formatString: hh:nn:ss
		lineageTag: d1eff32e-abdd-48e1-a30b-6cd52855096d

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure latest_eq_lat = ```
			
