	column EarthquakeType =
			
			SWITCH(
			    TRUE(),
			    [Magnitude] < 3.0, "Minor (<3.0)",
			    [Magnitude] < 5.0, "Light (3.0–4.9)",
			    [Magnitude] < 7.0, "Moderate (5.0–6.9)",
			    [Magnitude] < 9.0, "Strong (7.0–8.9)",
			    [Magnitude] >= 9.0, "Massive (>=9.0)"
			)
		lineageTag: 858a6e7b-66c5-47b2-91ae-f8710ad1c34c
		summarizeBy: none

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Continent =
			
			SWITCH(
			    TRUE(),
			    -- North America / Central America / Caribbean
			    'eq_data'[Country] IN {
			        "United States", "Canada", "Mexico", "Greenland", "Costa Rica", "Guatemala", "El Salvador", "Panama", "Nicaragua",
			        "Puerto Rico", "Virgin Islands, British", "Virgin Islands, U.S.", "Barbados", "Grenada", "Dominica", "Antigua and Barbuda",
			        "Trinidad and Tobago", "Haiti", "Dominican Republic", "Anguilla", "Bonaire, Sint Eustatius and Saba",
			        "Honduras", "Saint Kitts and Nevis", "Cayman Islands",
			        "Turks and Caicos Islands", "Sint Maarten (Dutch part)", "Martinique", "Saint Barthélemy",
			        "Guadeloupe"
			    }, "N America",
			    -- South America
			    'eq_data'[Country] IN {
			        "Argentina", "Brazil", "Chile", "Bolivia, Plurinational State of", "Colombia", "Peru", "French Guiana", "Venezuela, Bolivarian Republic of",
			        "Ecuador", "South Georgia and the South Sandwich Islands",
			        "Falkland Islands (Malvinas)"
			    }, "S America",
			    -- Asia
			    'eq_data'[Country] IN {
			        "Kazakhstan", "Turkmenistan", "Uzbekistan", "Tajikistan", "Mongolia", "China",
			        "Taiwan, Province of China", "Japan", "Philippines", "Indonesia", "Malaysia", "Timor-Leste",
			        "Christmas Island", "Cocos (Keeling) Islands",
			        "India", "Pakistan", "Nepal", "Iran, Islamic Republic of", "Afghanistan", "Maldives", "Yemen", "Oman", "Saudi Arabia",
			        "Myanmar", "Bhutan", "Azerbaijan", "Kyrgyzstan",
			        "Viet Nam", "Thailand", "Iraq", "Qatar", "Kuwait", "Georgia", "Armenia",
			        "Türkiye","Russian Federation"
			    }, "Asia",
			    -- Oceania
			    'eq_data'[Country] IN {
			        "Australia", "New Zealand", "Wallis and Futuna", "Tonga",
			        "Guam", "Northern Mariana Islands",
			        "Samoa", "Palau",
			        "Pitcairn", "Norfolk Island",
			        "New Caledonia", "Papua New Guinea", "Solomon Islands", "Vanuatu", "Fiji", "Micronesia, Federated States of"
			    }, "Oceania",
			    -- Africa
			    'eq_data'[Country] IN {
			        "Morocco", "Ethiopia", "Madagascar", "South Africa", "Tanzania, United Republic of", "Somalia", "Malawi",
			        "Mauritius", "Djibouti", "Burundi", "Equatorial Guinea", "Réunion", "Tunisia", "Sudan",
			        "Algeria", "Chad", "Zimbabwe", "Uganda", "Eritrea", "Gabon", "Congo, The Democratic Republic of the", "Rwanda", "Libya",
			        "Saint Helena, Ascension and Tristan da Cunha"
			    }, "Africa",
			    -- Europe
			    'eq_data'[Country] IN {
			        "Portugal", "Greece", "Poland", "Spain", "Albania", "Iceland", "Norway", "Cyprus", "Svalbard and Jan Mayen",
			        "Malta", "Italy", "Hungary",
			        "France", "Bosnia and Herzegovina", "Croatia", "Romania",
			        "Russia"
			    }, "Europe",
			    -- Antarctica
			    'eq_data'[Country] IN {
			        "Antarctica", "French Southern Territories"
			    }, "Antarctica",
			    "Other"
			)
		lineageTag: 492266ef-4472-4171-a0df-0977f6e11c0f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition eq_data = m
		mode: import
		source =
				let
				    Source = Sql.Database("myfreesqldbserver66.database.windows.net", "earthquake_analysis", [Query="select * from gold_data where magnitude > 0"]),
